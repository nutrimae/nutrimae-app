# Supabase — MESMO projeto do app principal (o tracking lê as tabelas
# analytics_* que o app principal grava). Copie o valor do .env.local raiz.
NEXT_PUBLIC_SUPABASE_URL=

# SERVICE ROLE — só existe no servidor, nunca vai pro navegador. Bypassa RLS
# de propósito: o app inteiro fica atrás de senha e só lê dados agregados.
# Copie o valor do .env.local raiz.
SUPABASE_SERVICE_ROLE_KEY=

# Senha única do painel (uso do dono). Você escolhe o valor.
# Sem ela configurada, NINGUÉM entra — o login é fail-closed.
TRACKING_DASHBOARD_PASSWORD=
