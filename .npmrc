# Rebill pina @stripe/stripe-js@8.11.0, mas @stripe/react-stripe-js@6.9.0 exige
# >=9.10.0 — conflito de peer dependency real, sem versão que agrade os dois
# pacotes ao mesmo tempo (as duas integracoes nao compartilham instancia do
# modulo em runtime, entao conviver assim e seguro). Sem isso aqui, "npm
# install" falha no build da Vercel com ERESOLVE (viu isso quebrar 2 deploys
# seguidos em 2026-09-10 antes de existir este arquivo).
legacy-peer-deps=true
