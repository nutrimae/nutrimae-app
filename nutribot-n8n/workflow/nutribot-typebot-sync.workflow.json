    {
      "id": "n8n-lwkvylja",
      "name": "Validate Sync Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Mesmo desembrulho de .body do Normalize Event (ver src/normalize.js) —\n// o node Webhook também embrulha o corpo aqui.\nconst envelope = $input.item.json;\nconst raw = (envelope && typeof envelope.body === 'object' && envelope.body) ? envelope.body : envelope;\nconst phone = String(raw.telefone ?? raw.phone ?? '').trim();\nconst idadeBebe = String(raw.idade_bebe ?? '').trim();\nif (!phone) { throw new Error('Sync do Typebot sem telefone — não é possível gravar idade_bebe.'); }\nreturn { json: { phone, idadeBebe } };"
      }
    },
    {
      "id": "n8n-dw4tkrrt",
      "name": "Sync idade_bebe",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        520,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres — NutriBot"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE nutribot_whatsapp_sessions\nSET idade_bebe = COALESCE(NULLIF($2, ''), idade_bebe), updated_at = NOW()\nWHERE phone = $1\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [$json.phone, $json.idadeBebe] }}"
        }
      }
    },
    {
      "id": "n8n-361x3oc8",
      "name": "Respond: Sync OK",
      "type": "n8n-nodes-base.respondToWebhook",
