NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional: link real do grupo de WhatsApp da comunidade (chat.whatsapp.com/...).
# O card só aparece na Comunidade das Mães quando essa variável está definida.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=

# Opcional: link de WhatsApp da equipe de suporte (wa.me/...).
# O card só aparece em Suporte quando essa variável está definida.
NEXT_PUBLIC_WHATSAPP_SUPPORT_URL=

# Opcional: ID do Pixel do Meta/Facebook. Sem ele, o FacebookPixel não
# injeta o script (fica só o tracking client-side, que é um no-op nesse caso).
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_VSL_URL=

# Checkout próprio (Pagar.me) — chave secreta da API, nunca exposta ao
# navegador. Usada por src/lib/payments/pagarme.ts.
PAGARME_API_KEY=

# Checkout próprio (Pagar.me) — usuário/senha de Basic Auth cadastrados em
# Configurações → Webhooks → "Habilitar autenticação" no painel do
# Pagar.me (são valores que você mesmo escolhe lá, não vêm prontos deles).
# Precisam ser IDÊNTICOS aos dois lados. Sem eles, o webhook rejeita tudo
# (fail-closed). Ver src/app/api/webhooks/pagarme/route.ts.
# PAGARME_WEBHOOK_PASSWORD também assina os tokens de polling de status do
# checkout (SEC-002, src/lib/checkout/status-token.ts) — sem ele, o checkout
# falha ao emitir o token (fail-closed).
PAGARME_WEBHOOK_USER=
PAGARME_WEBHOOK_PASSWORD=

# Checkout próprio (Pagar.me) — chave pública, usada só no navegador pra
# tokenizar cartão (o backend nunca recebe número de cartão/CVV).
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=

# Meta Conversions API — evento de Purchase server-side, disparado pelo
# webhook do Pagar.me depois que o pedido é confirmado pago (nunca antes).
# Sem essas duas variáveis, reportPurchaseToMeta() é um no-op silencioso —
# não bloqueia a liberação de acesso. Ver meta-conversion.js na raiz do
# repo (MÁQUINA_LOW_TICKET_BR.md) e src/app/api/webhooks/pagarme/route.ts.
META_ACCESS_TOKEN=
META_PIXEL_ID=
# Opcional, só enquanto estiver validando no Events Manager em modo teste.
META_TEST_EVENT_CODE=

# NutriBot (WhatsApp) — Cloud API oficial da Meta (único provedor; a
# Evolution API foi removida de vez). META_WHATSAPP_PHONE_NUMBER_ID e
# META_WHATSAPP_ACCESS_TOKEN vêm do painel do app em
# developers.facebook.com (produto WhatsApp). Ver
# src/lib/nutribot/whatsappCloudClient.ts.
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
# Segredo que você mesmo escolhe e cola no painel da Meta ao registrar a
# URL do webhook (handshake GET de verificação, hub.verify_token).
META_WHATSAPP_VERIFY_TOKEN=
# App Secret do app da Meta (developers.facebook.com → seu app →
# Configurações → Básico). A Meta assina cada POST do webhook com ele
# (X-Hub-Signature-256, HMAC-SHA256 do raw body). Sem essa variável o
# webhook rejeita TUDO (fail-closed) — ver src/lib/nutribot/webhook-auth.ts.
META_WHATSAPP_APP_SECRET=

# NutriBot — Typebot (conversa/coleta de e-mail/idade).
TYPEBOT_BASE_URL=https://typebot.co
TYPEBOT_PUBLIC_ID=
TYPEBOT_API_TOKEN=
TYPEBOT_TIMEOUT_MS=15000

# NutriBot — janela de sessão e cooldown de aviso de erro.
SESSION_TTL_HOURS=24
ERROR_MESSAGE_COOLDOWN_MINUTES=10
WHATSAPP_SEND_TIMEOUT_MS=10000

# Rate limit do checkout (SEC-005) — Upstash Redis via REST. Sem essas
# variáveis o rate limit cai no fallback in-memory (funciona, mas não é
# compartilhado entre instâncias serverless da Vercel). Ver
# src/lib/checkout/rate-limit.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Proteção contra bot no checkout (SEC-012) — Cloudflare Turnstile.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY é pública (vai pro navegador, renderiza o
# widget); TURNSTILE_SECRET_KEY é secreta (só o servidor usa, pra validar o
# token). Sem TURNSTILE_SECRET_KEY a verificação é pulada — ver
# src/lib/checkout/turnstile.ts. Criar em https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lembrete de Pix abandonado (ver vercel.json + src/app/api/cron/
# abandoned-checkout/route.ts) — a Vercel manda esse valor sozinha como
# "Authorization: Bearer ..." em toda chamada de Cron Job quando essa
# variável está configurada no projeto. Sem ela, a rota nunca roda
# (fail-closed).
CRON_SECRET=

# Segredo exclusivo para execuções E2E de Tracking em ambientes remotos.
# Nunca exponha no navegador. Em localhost, os eventos já são marcados como internos.
TRACKING_E2E_SECRET=

# Segredo pra marcar SEU navegador/celular como "interno" testando em
# produção (fora de localhost), sem poluir a Meta com falso resultado.
# Defina um valor aleatório aqui, depois visite uma vez, no dispositivo que
# você usa pra testar: https://app.nutrimae.app/api/internal/mark-device?secret=SEU_VALOR
# Isso grava um cookie de 1 ano — não precisa repetir. Nunca compartilhe esse valor.
INTERNAL_DEVICE_SECRET=

# Livro Ilustrado por IA. A geracao fica bloqueada por codigo enquanto as
# duas aprovacoes abaixo nao forem explicitamente ativadas na Vercel.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini
ILLUSTRATED_BOOK_PRIVACY_APPROVED=false
# Manter false ate confirmar contratualmente o tratamento de fotos reais de
# criancas (incluindo retencao e nao uso para treinamento).
OPENAI_REFERENCE_PHOTO_APPROVED=false

# Google Cloud Text-to-Speech (TTS)
GOOGLE_TTS_API_KEY=
