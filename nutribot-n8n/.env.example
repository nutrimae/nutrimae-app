# Copie para .env e preencha com valores reais. Nunca commite o .env real.
# Nunca cole valores reais nestes exemplos.

# --- n8n ---
N8N_HOST=
N8N_WEBHOOK_URL=

# --- PostgreSQL (substitui o Data Store do Make) ---
POSTGRES_URL=

# --- Redis (opcional — locks/dedup de alta velocidade; a dedup padrão já
# funciona só com Postgres, ver docs/route-map.md) ---
REDIS_URL=

# --- Evolution API ---
# URL/instância/apikey dos nodes "Evolution API: Send *" estão fixos no
# workflow (tools/generate-workflow.mjs), não vêm daqui ainda — ver
# docs/credentials.md seção 3 sobre essa exceção deliberada e como migrar
# para variável de ambiente quando o fluxo estiver validado.
WHATSAPP_SEND_TIMEOUT_MS=10000

# --- Typebot ---
TYPEBOT_BASE_URL=https://typebot.io
TYPEBOT_PUBLIC_ID=my-typebot-1slh1qn
TYPEBOT_API_TOKEN=
TYPEBOT_TIMEOUT_MS=15000

# --- CartPanda ---
# Usado dentro do PRÓPRIO Typebot (bloco de "assinatura não encontrada"),
# nunca deixar "[SEU LINK DO CARTPANDA]" hardcoded — ver
# docs/typebot-flow-changes.md.
CARTPANDA_CHECKOUT_URL=

# --- Sessão ---
SESSION_TTL_HOURS=24
ERROR_MESSAGE_COOLDOWN_MINUTES=10
